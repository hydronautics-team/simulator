<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="sauvc_2027">
    <physics name="default_physics" default="true" type="dartsim">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <scene>
      <ambient>0.12 0.16 0.18 1</ambient>
      <background>0.04 0.12 0.18 1</background>
      <shadows>true</shadows>
      <fog><color>0.05 0.18 0.24 1</color><type>linear</type><start>8</start><end>35</end></fog>
    </scene>
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <include><uri>model://sea_floor</uri><pose>0 0 -10 0 0 0</pose></include>
    <include><uri>model://ocean_surface</uri><pose>0 0 0 0 0 0</pose></include>

    <!-- First competition test object: a high-contrast 3 x 3 metre gate.
         It starts outside the centre of the camera image (20 degrees left),
         so the gate-search state must rotate before approaching it. -->
    <model name="competition_gate">
      <static>true</static>
      <pose>8 6 -2 0 0 0</pose>
      <link name="gate">
        <visual name="left_post">
          <pose>0 1.5 0 0 0 0</pose>
          <geometry><cylinder><radius>0.14</radius><length>3.2</length></cylinder></geometry>
          <material>
            <ambient>1 0.2 0.01 1</ambient><diffuse>1 0.28 0.01 1</diffuse>
            <specular>0.25 0.25 0.25 1</specular>
            <pbr><metal><roughness>0.55</roughness><metalness>0.0</metalness></metal></pbr>
          </material>
        </visual>
        <collision name="left_post_collision">
          <pose>0 1.5 0 0 0 0</pose>
          <geometry><cylinder><radius>0.14</radius><length>3.2</length></cylinder></geometry>
        </collision>
        <visual name="right_post">
          <pose>0 -1.5 0 0 0 0</pose>
          <geometry><cylinder><radius>0.14</radius><length>3.2</length></cylinder></geometry>
          <material>
            <ambient>1 0.2 0.01 1</ambient><diffuse>1 0.28 0.01 1</diffuse>
            <specular>0.25 0.25 0.25 1</specular>
            <pbr><metal><roughness>0.55</roughness><metalness>0.0</metalness></metal></pbr>
          </material>
        </visual>
        <collision name="right_post_collision">
          <pose>0 -1.5 0 0 0 0</pose>
          <geometry><cylinder><radius>0.14</radius><length>3.2</length></cylinder></geometry>
        </collision>
        <visual name="top_bar">
          <pose>0 0 1.5 1.57079632679 0 0</pose>
          <geometry><cylinder><radius>0.16</radius><length>3.28</length></cylinder></geometry>
          <material>
            <ambient>1 0.72 0.01 1</ambient><diffuse>1 0.82 0.02 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
            <pbr><metal><roughness>0.5</roughness><metalness>0.0</metalness></metal></pbr>
          </material>
        </visual>
        <collision name="top_bar_collision">
          <pose>0 0 1.5 1.57079632679 0 0</pose>
          <geometry><cylinder><radius>0.16</radius><length>3.28</length></cylinder></geometry>
        </collision>
        <visual name="left_foot">
          <pose>0 1.5 -1.6 0 0 0</pose>
          <geometry><box><size>1.2 0.5 0.12</size></box></geometry>
          <material><ambient>0.85 0.18 0.01 1</ambient><diffuse>1 0.28 0.01 1</diffuse></material>
        </visual>
        <collision name="left_foot_collision">
          <pose>0 1.5 -1.6 0 0 0</pose>
          <geometry><box><size>1.2 0.5 0.12</size></box></geometry>
        </collision>
        <visual name="right_foot">
          <pose>0 -1.5 -1.6 0 0 0</pose>
          <geometry><box><size>1.2 0.5 0.12</size></box></geometry>
          <material><ambient>0.85 0.18 0.01 1</ambient><diffuse>1 0.28 0.01 1</diffuse></material>
        </visual>
        <collision name="right_foot_collision">
          <pose>0 -1.5 -1.6 0 0 0</pose>
          <geometry><box><size>1.2 0.5 0.12</size></box></geometry>
        </collision>
      </link>
