          <geometry><box><size>0.8 0.3 0.08</size></box></geometry>
          <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <collision name="left_foot_collision">
          <pose>0 0.85 -0.63 0 0 0</pose>
