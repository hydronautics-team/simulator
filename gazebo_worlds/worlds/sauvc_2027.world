<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="sauvc_2027">
    <physics name="default_physics" default="true" type="dartsim">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <scene>
      <ambient>0.12 0.16 0.18 1</ambient>
      <background>0.04 0.12 0.18 1</background>
      <shadows>true</shadows>
      <fog><color>0.05 0.18 0.24 1</color><type>linear</type><start>8</start><end>35</end></fog>
    </scene>
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <include><uri>model://sea_floor</uri><pose>0 0 -10 0 0 0</pose></include>
    <include><uri>model://ocean_surface</uri><pose>0 0 0 0 0 0</pose></include>

    <!-- SAUVC navigation gate. The 1.5 m clear opening and 1.0 m useful
         height follow the competition specification. Red striped markings
         identify port and green striped markings identify starboard.
         It starts outside the centre of the camera image, so the gate-search
         state must rotate before approaching it. -->
    <model name="competition_gate">
      <static>true</static>
      <pose>8 6 -2 0 0 0</pose>
      <link name="gate">
        <!-- Port post: red / white identification bands. -->
        <visual name="port_red_lower">
          <pose>0 0.85 -0.48 0 0 0</pose>
          <geometry><cylinder><radius>0.1</radius><length>0.24</length></cylinder></geometry>
          <material><ambient>0.8 0.01 0.01 1</ambient><diffuse>1 0.02 0.02 1</diffuse></material>
        </visual>
        <visual name="port_white_lower">
          <pose>0 0.85 -0.24 0 0 0</pose>
          <geometry><cylinder><radius>0.1</radius><length>0.24</length></cylinder></geometry>
          <material><ambient>0.75 0.75 0.7 1</ambient><diffuse>0.95 0.95 0.9 1</diffuse></material>
        </visual>
        <visual name="port_red_middle">
          <pose>0 0.85 0 0 0 0</pose>
          <geometry><cylinder><radius>0.1</radius><length>0.24</length></cylinder></geometry>
          <material><ambient>0.8 0.01 0.01 1</ambient><diffuse>1 0.02 0.02 1</diffuse></material>
        </visual>
        <visual name="port_white_upper">
          <pose>0 0.85 0.24 0 0 0</pose>
          <geometry><cylinder><radius>0.1</radius><length>0.24</length></cylinder></geometry>
          <material><ambient>0.75 0.75 0.7 1</ambient><diffuse>0.95 0.95 0.9 1</diffuse></material>
        </visual>
        <visual name="port_red_upper">
          <pose>0 0.85 0.48 0 0 0</pose>
          <geometry><cylinder><radius>0.1</radius><length>0.24</length></cylinder></geometry>
          <material><ambient>0.8 0.01 0.01 1</ambient><diffuse>1 0.02 0.02 1</diffuse></material>
        </visual>
        <collision name="left_post_collision">
          <pose>0 0.85 0 0 0 0</pose>
          <geometry><cylinder><radius>0.1</radius><length>1.2</length></cylinder></geometry>
        </collision>
        <!-- Starboard post: green / white identification bands. -->
        <visual name="starboard_green_lower">
          <pose>0 -0.85 -0.48 0 0 0</pose>
          <geometry><cylinder><radius>0.1</radius><length>0.24</length></cylinder></geometry>
          <material><ambient>0.01 0.5 0.02 1</ambient><diffuse>0.02 0.85 0.03 1</diffuse></material>
        </visual>
        <visual name="starboard_white_lower">
          <pose>0 -0.85 -0.24 0 0 0</pose>
          <geometry><cylinder><radius>0.1</radius><length>0.24</length></cylinder></geometry>
          <material><ambient>0.75 0.75 0.7 1</ambient><diffuse>0.95 0.95 0.9 1</diffuse></material>
        </visual>
        <visual name="starboard_green_middle">
          <pose>0 -0.85 0 0 0 0</pose>
          <geometry><cylinder><radius>0.1</radius><length>0.24</length></cylinder></geometry>
          <material><ambient>0.01 0.5 0.02 1</ambient><diffuse>0.02 0.85 0.03 1</diffuse></material>
        </visual>
        <visual name="starboard_white_upper">
          <pose>0 -0.85 0.24 0 0 0</pose>
          <geometry><cylinder><radius>0.1</radius><length>0.24</length></cylinder></geometry>
          <material><ambient>0.75 0.75 0.7 1</ambient><diffuse>0.95 0.95 0.9 1</diffuse></material>
        </visual>
        <visual name="starboard_green_upper">
          <pose>0 -0.85 0.48 0 0 0</pose>
          <geometry><cylinder><radius>0.1</radius><length>0.24</length></cylinder></geometry>
          <material><ambient>0.01 0.5 0.02 1</ambient><diffuse>0.02 0.85 0.03 1</diffuse></material>
        </visual>
        <collision name="right_post_collision">
          <pose>0 -0.85 0 0 0 0</pose>
          <geometry><cylinder><radius>0.1</radius><length>1.2</length></cylinder></geometry>
        </collision>
        <visual name="top_bar">
          <pose>0 0 0.6 1.57079632679 0 0</pose>
          <geometry><cylinder><radius>0.1</radius><length>1.9</length></cylinder></geometry>
          <material>
            <ambient>0.75 0.75 0.7 1</ambient><diffuse>0.95 0.95 0.9 1</diffuse>
            <specular>0.25 0.25 0.25 1</specular>
            <pbr><metal><roughness>0.5</roughness><metalness>0.0</metalness></metal></pbr>
