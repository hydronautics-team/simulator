<sdf version="1.5">
  <world name="empty_underwater">
    <physics name="default_physics" default="true" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>0.5</sor>
        </solver>
      </ode>
    </physics>
    <scene>
      <ambient>0.01 0.01 0.01 1.0</ambient>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
      <shadows>1</shadows>
      <fog>
        <color>0.1 0.2 0.3 1.0</color>
        <type>linear</type>
        <density>0.001</density>
        <start>10</start>
        <end>200</end>
      </fog>
    </scene>

    <!-- Origin placed somewhere in the middle of the North Sea  -->
    <spherical_coordinates>
      <latitude_deg>56.71897669633431</latitude_deg>
      <longitude_deg>3.515625</longitude_deg>
    </spherical_coordinates>

    <!-- Global light source -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Orange seafloor at 100 m depth (collision) -->
    <include>
      <uri>model://sea_floor</uri>
      <pose>0 0 -100 0 0 0</pose>
    </include>

    <!-- Bluish transparent ocean surface at z = 0 (visual only) -->
    <include>
      <uri>model://ocean_surface</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

  <!-- ROS 2 integration is provided by ros_gz_sim / ros_gz_bridge (gz sim
       publishes /clock, /world/<world_name>/state, pose/info, ... natively).
       The legacy Gazebo Classic bridge plugin (libgazebo_ros_state.so) is
       intentionally not used here. -->

  </world>
</sdf>
