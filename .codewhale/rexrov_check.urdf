<robot name="rexrov">
  <!--
      The RexROV meshes and hydrodynamic parameters are based on the parameters and dimensions
      from the SF 30k.

      References:
        [1] Dukan, Fredrik. "ROV Motion Control Systems." PhD Thesis, NTNU, 2014.
        [2] Berg, Viktor. Development and Commissioning of a DP system for ROV SF 30k. MS
            thesis. Institutt for marin teknikk, 2012.

      Hull-only model: no sensors, thrusters or gazebo plugins.
      The mesh path is relative to the generated URDF/SDF, see CMakeLists.txt.
  -->
  <!--
      RexROV thruster geometry, identical to the UUV Simulator rexrov:
      thrusters 0-3 - main (vectored) thrusters at the top corners,
      thrusters 4-7 - vertical thrusters.

      Each thruster is a propeller link on a continuous joint (the thrust
      axis is the joint's local x-axis), driven by the built-in
      ignition::gazebo::systems::Thruster. Commands arrive on
      /model/<model>/joint/<joint>/cmd_thrust (gz.msgs.Double, Newtons) and
      are produced by the RexrovThrusterSystem allocator, which discovers
      these joints automatically by their "thruster_" name prefix.
  -->
  <!-- base_link according to ROS conventions: x forward, z up -->
  <link name="base_link">
    <inertial>
      <mass value="1862.87"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="525.39" ixy="1.44" ixz="33.41" iyy="794.20" iyz="2.6" izz="691.23"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/RexROV_no_props.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <!-- bottom plate -->
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.75"/>
      <geometry>
        <box size="2.56 1.50 0.10"/>
      </geometry>
    </collision>
    <!-- top plate -->
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.60"/>
      <geometry>
        <box size="2.56 1.50 0.40"/>
      </geometry>
    </collision>
    <!-- left / right sides -->
    <collision>
      <origin rpy="0 0 0" xyz="-0.20 0.70 -0.15"/>
      <geometry>
        <box size="2.20 0.10 1.10"/>
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0 0" xyz="-0.20 -0.70 -0.15"/>
      <geometry>
        <box size="2.20 0.10 1.10"/>
      </geometry>
    </collision>
  </link>
  <!-- Extension point for future gazebo plugin blocks (e.g. hydrodynamics) -->
  <gazebo>
    <plugin filename="libRexrovThrusterSystem.so" name="simulator_gazebo_plugins::RexrovThrusterSystem">
      <cmd_topic>/model/rexrov/cmd_vel</cmd_topic>
      <joint_prefix>thruster_</joint_prefix>
      <force_gain>1500</force_gain>
      <torque_gain>1000</torque_gain>
      <time_constant>0.05</time_constant>
    </plugin>
  </gazebo>
  <link name="thruster_0">
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.00000001" ixy="0.0" ixz="0.0" iyy="0.00000001" iyz="0.0" izz="0.00000001"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.15" radius="0.06"/>
      </geometry>
      <material name="">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="thruster_0_joint" type="continuous">
    <parent link="base_link"/>
    <child link="thruster_0"/>
    <origin rpy="0.0 -1.3007937037 -0.9286895609" xyz="-0.890895 0.334385 0.528822"/>
    <axis xyz="1 0 0"/>
  </joint>
  <gazebo>
    <plugin filename="ignition-gazebo-thruster-system" name="ignition::gazebo::systems::Thruster">
      <joint_name>thruster_0_joint</joint_name>
      <thrust_coefficient>0.004422</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.2</propeller_diameter>
    </plugin>
  </gazebo>
