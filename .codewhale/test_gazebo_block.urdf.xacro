<?xml version="1.0"?>
<robot name="t" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <link name="base_link">
    <inertial>
      <mass value="1862.87"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="525.39" ixy="1.44" ixz="33.41" iyy="794.20" iyz="2.6" izz="691.23"/>
    </inertial>
    <visual>
      <geometry><box size="1 1 1"/></geometry>
    </visual>
  </link>
  <gazebo>
    <plugin filename="libFoo.so" name="Foo">
      <link_name>base_link</link_name>
      <cmd_topic>/model/rexrov/cmd_vel</cmd_topic>
      <thruster>
        <id>0</id>
        <pose>-0.89 0.33 0.53 0 -1.30 -0.93</pose>
      </thruster>
      <thruster>
        <id>1</id>
        <pose>-0.89 -0.33 0.53 0 -1.30 0.93</pose>
      </thruster>
    </plugin>
